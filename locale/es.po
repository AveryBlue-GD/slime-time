msgctxt "web.lost"
msgid ""
"The graphics stopped working (the browser reset WebGL).\n"
"Your progress is saved."
msgstr ""
"Los gráficos han dejado de funcionar (el navegador reinició WebGL).\n"
"Tu progreso está guardado."

