extends Node

## Autoload "Music": the hub's music and the story intro's track (assets/music/, generated by
## `tools/make_music.py --game`; docs/marketing/music.md). Each time the hub is entered from somewhere
## else (the title, a level), one of the three hub loops is picked at random (never the same one twice in
## a row) and fades in; it keeps playing on the hub's own screens and fades out when a level, the title or
## any other screen starts. The intro track follows the intro's shots (StoryScreen calls play_intro and
## seek_shot). Plays on the Master bus like Sfx; silent while Progress.sound_on is false.

const HUB_TRACKS: Array[String] = ["res://assets/music/hub_a.ogg", "res://assets/music/hub_b.ogg", "res://assets/music/hub_c.ogg"]
const INTRO_TRACK := "res://assets/music/story_intro.ogg"
## The hub and its screens: the hub music starts (or keeps playing) on them.
const HUB_SCENES: Array[String] = ["res://scenes/hub.tscn", "res://scenes/level_select.tscn", "res://scenes/skins.tscn",
	"res://scenes/maps.tscn", "res://scenes/upgrades.tscn"]
## Screens that keep whatever is playing: the settings pages (opened from the hub and from the title) and
## the story (which starts its own track).
const KEEP_SCENES: Array[String] = ["res://scenes/controls.tscn", "res://scenes/key_controls.tscn", "res://scenes/language.tscn",
	"res://scenes/story.tscn"]
## Playback level (dB) of each kind: the hub loops are mastered to -18 LUFS, the intro to -21 LUFS
## (tools/make_music.py), both meant to sit under the sound effects.
const HUB_DB := -3.0
const INTRO_DB := 0.0
const FADE_IN := 1.5
const FADE_OUT := 0.6
## The intro is only re-synced to a shot when it has drifted further than this (s) from the shot's start.
const SEEK_SLACK := 0.3

## The track playing (a res:// path, empty when silent).
var current := ""
var _player: AudioStreamPlayer
var _base_db := 0.0
## Fade level 0..1, where it is heading, and how fast (per second).
var _level := 0.0
var _target := 0.0
var _rate := 1.0
var _last_hub := -1


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_player = AudioStreamPlayer.new()
	_player.volume_db = -80.0
	add_child(_player)
	get_tree().scene_changed.connect(_on_scene_changed)


func _exit_tree() -> void:
	_player.stop()
	_player.stream = null  # (nothing left holding the stream at quit)


func _on_scene_changed() -> void:
	var scene := get_tree().current_scene
	if scene:
		follow_scene(scene.scene_file_path)


## What the music does on (or just before: Transition.go calls it as its wipe starts) arriving at `path`.
func follow_scene(path: String) -> void:
	if path in HUB_SCENES:
		play_hub()
	elif not path in KEEP_SCENES:
		stop()


func is_hub_music() -> bool:
	return current in HUB_TRACKS


## Starts a random hub loop, or lets the one playing carry on (fading back in if it was fading out).
func play_hub() -> void:
	if is_hub_music():
		_fade_to(1.0, FADE_IN)
		return
	var pick := randi() % HUB_TRACKS.size()
	if pick == _last_hub:
		pick = (pick + 1 + randi() % (HUB_TRACKS.size() - 1)) % HUB_TRACKS.size()
	_last_hub = pick
	_start(HUB_TRACKS[pick], true, HUB_DB, FADE_IN)


## The story intro's track, from the top.
func play_intro() -> void:
	_start(INTRO_TRACK, false, INTRO_DB, 0.0)


## The intro moved on to the shot that starts `seconds` into it (a skip, or a held Reduce Motion still):
## jumps there if the music has drifted, so each section stays with its shot.
func seek_shot(seconds: float) -> void:
	if current == INTRO_TRACK and _player.playing and absf(_player.get_playback_position() - seconds) > SEEK_SLACK:
		_player.seek(seconds)


func stop(fade := FADE_OUT) -> void:
	if current != "":
		_fade_to(0.0, fade)


func _start(path: String, loop: bool, db: float, fade: float) -> void:
	var stream := load(path) as AudioStreamOggVorbis
	if stream == null:
		return
	stream.loop = loop
	current = path
	_player.stream = stream
	_base_db = db
	_level = 0.0
	_fade_to(1.0, fade)
	_apply_volume()
	_player.play()


func _fade_to(level: float, seconds: float) -> void:
	_target = level
	_rate = 1.0 / seconds if seconds > 0.0 else INF
	if seconds <= 0.0:
		_level = level


func _process(delta: float) -> void:
	if current == "":
		return
	_level = move_toward(_level, _target, delta * _rate)
	if (_level <= 0.0 and _target <= 0.0) or not _player.playing:
		_player.stop()
		current = ""
		return
	_apply_volume()


func _apply_volume() -> void:
	var progress := get_node_or_null("/root/Progress")
	var on: bool = progress == null or progress.sound_on
	_player.volume_db = _base_db + linear_to_db(_level) if on and _level > 0.0 else -80.0
