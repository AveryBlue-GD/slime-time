class_name Themes
extends RefCounted

## Art themes: each story level has its own look, and every randomizer maze picks one at random
## (from its seed, so replaying a maze keeps its theme). A theme has its own tile art (stone
## layout, decorations and palette, generated by tools/make_theme_art.py into
## assets/sprites/themes/) and its own fog colors. "dungeon" keeps the original look (plus two more wall constructions).
##
## fog: [deep, mist] (none = the fog shader's defaults).

const DUNGEON := "dungeon"
## The fog shader's own default colors (the dungeon).
const DEFAULT_FOG_DEEP := Color(0.078, 0.078, 0.133, 1.0)
const DEFAULT_FOG_MIST := Color(0.247, 0.239, 0.341, 1.0)

const ALL := {
	"dungeon": {name = "DARK DUNGEON"},  # i18n: ignore (English source; shown via display_name)
	"mossy": {name = "MOSSY MINES", fog = [Color8(12, 24, 18), Color8(42, 66, 50)]},  # i18n: ignore (English source; shown via display_name)
	"sandstone": {name = "SANDSTONE SANCTUM", fog = [Color8(30, 22, 20), Color8(90, 72, 58)]},  # i18n: ignore (English source; shown via display_name)
	"sunken": {name = "SUNKEN SHRINE", fog = [Color8(8, 20, 30), Color8(36, 70, 84)]},  # i18n: ignore (English source; shown via display_name)
	"sewers": {name = "TOXIC TUNNELS", fog = [Color8(24, 26, 8), Color8(98, 106, 30)]},  # i18n: ignore (English source; shown via display_name)
	"catacombs": {name = "CREEPY CATACOMBS", fog = [Color8(24, 20, 18), Color8(74, 66, 60)]},  # i18n: ignore (English source; shown via display_name)
	"frozen": {name = "FROZEN FORTRESS", fog = [Color8(14, 20, 38), Color8(72, 98, 134)]},  # i18n: ignore (English source; shown via display_name)
	"obsidian": {name = "OBSIDIAN OUBLIETTE", fog = [Color8(6, 6, 12), Color8(34, 36, 58)]},  # i18n: ignore (English source; shown via display_name)
	"crystal": {name = "CRYSTAL CAVERNS", fog = [Color8(20, 10, 34), Color8(78, 50, 110)]},  # i18n: ignore (English source; shown via display_name)
	"volcanic": {name = "VOLCANIC VAULT", fog = [Color8(28, 10, 10), Color8(90, 36, 28)]},  # i18n: ignore (English source; shown via display_name)
}

## One per story level, getting stranger the deeper you go.
const BY_LEVEL: Array[String] = [
	"dungeon", "mossy", "sandstone", "sunken", "sewers",
	"catacombs", "frozen", "obsidian", "crystal", "volcanic",
]


static func for_level(level: int) -> String:
	return BY_LEVEL[clampi(level, 1, BY_LEVEL.size()) - 1]


## A random theme for a randomizer maze, fixed by its seed (in the demo, one of the demo's themes:
## the others' art isn't in a demo export, docs/demo-plan.md).
static func for_seed(maze_seed: int) -> String:
	var rng := RandomNumberGenerator.new()
	rng.seed = maze_seed * 31 + 7
	var pool: Array[String] = Demo.themes() if Demo.on() else BY_LEVEL
	return pool[rng.randi_range(0, pool.size() - 1)]


static func display_name(id: String) -> String:
	match id:
		"mossy":
			return Loc.t("theme.mossy", "MOSSY MINES")
		"sandstone":
			return Loc.t("theme.sandstone", "SANDSTONE SANCTUM")
		"sunken":
			return Loc.t("theme.sunken", "SUNKEN SHRINE")
		"sewers":
			return Loc.t("theme.sewers", "TOXIC TUNNELS")
		"catacombs":
			return Loc.t("theme.catacombs", "CREEPY CATACOMBS")
		"frozen":
			return Loc.t("theme.frozen", "FROZEN FORTRESS")
		"obsidian":
			return Loc.t("theme.obsidian", "OBSIDIAN OUBLIETTE")
		"crystal":
			return Loc.t("theme.crystal", "CRYSTAL CAVERNS")
		"volcanic":
			return Loc.t("theme.volcanic", "VOLCANIC VAULT")
	# i18n: level name, HUD area line and map table; keep the alliteration if the language can
	return Loc.t("theme.dungeon", "DARK DUNGEON")


## Path of a theme's tile atlas: `kind` is "walls", "floors", "fillets" or "border".
static func atlas_path(id: String, kind: String) -> String:
	return "res://assets/sprites/themes/%s_%s.png" % [id if ALL.has(id) else DUNGEON, kind]


## The fog's [deep, mist] colors, or an empty array to keep the default.
## With `tint` (see Skins.atmosphere_color) the colors lean toward the skin's hue, same brightness.
static func fog_colors(id: String, tint := Color(0, 0, 0, 0)) -> Array:
	var colors: Array = ALL.get(id, ALL[DUNGEON]).get("fog", [])
	if tint.a <= 0.0:
		return colors
	if colors.is_empty():
		colors = [DEFAULT_FOG_DEEP, DEFAULT_FOG_MIST]
	return [Skins.tinted(colors[0], tint, Skins.ATMOSPHERE_FOG_MIX), Skins.tinted(colors[1], tint, Skins.ATMOSPHERE_FOG_MIX)]
