# Godot cache and editor state
.godot/
*.tmp

# Build output (exports go to build/windows and build/web)
/build/

# Screenshots captured by tools/screenshot.ps1
/.screens/

# Personal Claude Code settings (shared ones live in .claude/settings.json)
.claude/settings.local.json

# Rendered itch.io images (regenerate with tools/promo/make_promo.ps1)
/itch-images/

# Temporary no-focus window override written by tools/play.ps1 and screenshot.ps1
/override.cfg

# Local recordings and macOS cruft
.DS_Store
docs/polish-shots/*.avi
docs/polish-shots/*.mp4
docs/spring-cleaning/perf/*.mp4
__pycache__/
