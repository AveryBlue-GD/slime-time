extends "res://tests/suite_base.gd"

## The translation catalogs (docs/i18n/plan.md section 9.1, chunk B): locale/messages.pot (generated by
## tools/i18n_extract.py from the Loc.t / Loc.n calls) and one locale/<code>.po per supported language.
## - every supported locale (Language.LOCALES minus English) has its .po, and no other .po exists;
## - each header: Language = the file name, Plural-Forms = the table below, and Godot itself loads the
##   file with that locale and evaluates its plural rule to the expected form for every n;
## - every template entry is in every .po with the same English text, no extra entries, the locale's
##   number of plural forms;
## - every translated msgstr: the English placeholders ({count}... a plural form that covers a single n,
##   like Arabic "one" / "two", may leave {count} out), no printf format, within its `lines N` budget;
## - gate on, the real Language autoload with the real catalogs returns each translation, and English for
##   anything untranslated or fuzzy (an empty msgstr never blanks a label).
## Locales listed in COMPLETE_LOCALES must have every entry translated (chunk H adds each finished one).
## The deeper text checks (NFC, ALL CAPS, Turkish casing, code completeness) are in
## `python3 tools/i18n_extract.py --check`; `--self-test` tests the extractor itself.
## Run: ./tools/godot.sh --path . --headless --fixed-fps 60 --quit-after 60000 -s res://tests/test_i18n_catalog.gd

const LOCALE_DIR := "res://locale"
const TEMPLATE := "res://locale/messages.pot"
## Locales whose translation is finished: a missing or fuzzy entry there fails the suite.
const COMPLETE_LOCALES: Array[String] = [
	"es", "pt_BR", "fr", "de", "it", "ru", "pl", "tr", "ja", "ko", "zh_CN", "zh_TW", "th", "vi", "id", "ar", "hi",
]
## Same table as tools/i18n_extract.py PLURALS: code -> Plural-Forms.
const PLURAL_FORMS := {
	"es": "nplurals=2; plural=(n != 1);",
	"pt_BR": "nplurals=2; plural=(n > 1);",
	"fr": "nplurals=2; plural=(n > 1);",
	"de": "nplurals=2; plural=(n != 1);",
	"it": "nplurals=2; plural=(n != 1);",
	"ru": "nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);",
	"pl": "nplurals=3; plural=(n==1 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);",
	"tr": "nplurals=2; plural=(n != 1);",
	"ja": "nplurals=1; plural=0;",
	"ko": "nplurals=1; plural=0;",
	"zh_CN": "nplurals=1; plural=0;",
	"zh_TW": "nplurals=1; plural=0;",
	"th": "nplurals=1; plural=0;",
	"vi": "nplurals=1; plural=0;",
	"id": "nplurals=1; plural=0;",
	"ar": "nplurals=6; plural=(n==0 ? 0 : n==1 ? 1 : n==2 ? 2 : n%100>=3 && n%100<=10 ? 3 : n%100>=11 ? 4 : 5);",
	"hi": "nplurals=2; plural=(n > 1);",
}
const SAMPLE_COUNTS := [0, 1, 2, 3, 4, 5, 10, 11, 12, 14, 21, 22, 25, 99, 100, 101, 102, 103, 111, 112, 1000, 1001]

var test_save := throwaway_save()
var progress: Node
var language: Node
var _placeholder := RegEx.create_from_string("\\{([A-Za-z_][A-Za-z0-9_]*)\\}")
var _printf := RegEx.create_from_string("%%|%[-+ 0#]*\\d*(?:\\.\\d+)?[sdifxXcvo]")
var _budget_lines := RegEx.create_from_string("^budget:.*\\blines (\\d+)")


func _initialize() -> void:
	await process_frame
	progress = root.get_node("Progress")
	language = root.get_node("Language")
	progress.save_path = test_save
	progress.saving_enabled = false
	progress.dev_tools = false
	var template := _parse(TEMPLATE)
	_check(template.ok, "messages.pot exists and parses")
	print("  (template: %d strings)" % template.entries.size())
	_locale_list()
	var catalogs := {}
	for code: String in PLURAL_FORMS:
		catalogs[code] = _parse("%s/%s.po" % [LOCALE_DIR, code])
		_check_file(code, catalogs[code], template)
	_godot_plural_rules()
	_fallback_to_english(template, catalogs)
	_result()
	quit(1 if failures else 0)


## The test's locale table is Language's list minus English, and locale/ holds exactly those .po files.
func _locale_list() -> void:
	var codes: Array[String] = language.codes()
	codes.erase("en")
	var table: Array = PLURAL_FORMS.keys()
	_check(codes.size() == 17 and codes == table, "17 locales, the same as Language.LOCALES (minus en)")
	var files: Array[String] = []
	for file in DirAccess.get_files_at(LOCALE_DIR):
		if file.ends_with(".po"):
			files.append(file.get_basename())
	files.sort()
	var want := codes.duplicate()
	want.sort()
	_check(files == want, "locale/ has one .po per supported locale and nothing else (%s)" % ", ".join(files))


func _check_file(code: String, po: Dictionary, template: Dictionary) -> void:
	var tag := "%s.po" % code
	if not po.ok:
		_check(false, tag + " exists and parses")
		return
	_check(po.header.get("Language", "") == code, tag + ": header Language is " + code)
	_check(po.header.get("Plural-Forms", "") == PLURAL_FORMS[code], tag + ": header Plural-Forms")
	_check(po.header.get("Content-Type", "").contains("charset=UTF-8"), tag + ": UTF-8")
	var translation := load("%s/%s.po" % [LOCALE_DIR, code]) as Translation
	_check(translation != null and translation.get_locale() == code, tag + ": Godot loads it as locale " + code)
	if translation:
		_check(String(translation.get("plural_rules_override")).ends_with(PLURAL_FORMS[code]),
			tag + ": Godot reads its Plural-Forms")
	var nplurals := _nplurals(code)
	var missing: Array[String] = []
	var wrong: Array[String] = []
	var bad_forms: Array[String] = []
	var bad_text: Array[String] = []
	var untranslated := 0
	for ctx: String in template.entries:
		var want: Dictionary = template.entries[ctx]
		if not po.entries.has(ctx):
			missing.append(ctx)
			continue
		var got: Dictionary = po.entries[ctx]
		if got.msgid != want.msgid or got.plural != want.plural:
			wrong.append(ctx)
			continue
		if want.plural != null and got.msgstr.size() != nplurals:
			bad_forms.append(ctx)
		if got.fuzzy or (got.msgstr as Array).has(""):
			untranslated += 1
		for k in got.msgstr.size():
			var problem := _text_problem(code, want, k, got.msgstr[k])
			if problem != "":
				bad_text.append("%s[%d]: %s" % [ctx, k, problem])
	var extra: Array[String] = []
	for ctx: String in po.entries:
		if not template.entries.has(ctx):
			extra.append(ctx)
	_check(missing.is_empty(), tag + ": every template entry is there" + _list(missing))
	_check(wrong.is_empty(), tag + ": same English text as the template" + _list(wrong))
	_check(extra.is_empty(), tag + ": no entry the template lacks" + _list(extra))
	_check(bad_forms.is_empty(), tag + ": %d plural forms per plural entry" % nplurals + _list(bad_forms))
	_check(bad_text.is_empty(), tag + ": translations keep the placeholders, no printf, within the line budget"
		+ _list(bad_text))
	if code in COMPLETE_LOCALES:
		_check(untranslated == 0, tag + ": complete (%d untranslated or fuzzy)" % untranslated)
	else:
		print("  note %s: %d of %d entries still untranslated" % [tag, untranslated, template.entries.size()])


## "" when a msgstr is fine (empty = untranslated, fine here), else what is wrong with it.
func _text_problem(code: String, want: Dictionary, form: int, text: String) -> String:
	if text == "":
		return ""
	var english: Dictionary = _names(want.msgid)
	if want.plural != null:
		english.merge(_names(want.plural))
	var need := english.duplicate()
	if want.plural != null and _single_n_form(code, form):
		need.erase("count")
	var got := _names(text)
	for name: String in need:
		if not got.has(name):
			return "{%s} missing" % name
	for name: String in got:
		if not english.has(name):
			return "{%s} is not in the English" % name
	if _printf.search(text):
		return "printf format"
	if want.lines > 0 and text.count("\n") + 1 > want.lines:
		return "%d lines, budget %d" % [text.count("\n") + 1, want.lines]
	return ""


## Godot evaluates each locale's Plural-Forms to the same form as the rule here, for many n
## (a throwaway catalog per locale in user://, form k translated as "F<k>").
func _godot_plural_rules() -> void:
	for code: String in PLURAL_FORMS:
		var path := "user://test_i18n_catalog_%d_%s.po" % [OS.get_process_id(), code]
		_temp_files.append(path)
		var lines := PackedStringArray(['msgid ""', 'msgstr ""', '"Language: %s\\n"' % code,
			'"Content-Type: text/plain; charset=UTF-8\\n"', '"Plural-Forms: %s\\n"' % PLURAL_FORMS[code], "",
			'msgctxt "t"', 'msgid "{count} ONE"', 'msgid_plural "{count} MANY"'])
		for k in _nplurals(code):
			lines.append('msgstr[%d] "F%d"' % [k, k])
		var file := FileAccess.open(path, FileAccess.WRITE)
		file.store_string("\n".join(lines) + "\n")
		file.close()
		var translation := load(path) as Translation
		var wrong: Array[String] = []
		for n: int in SAMPLE_COUNTS:
			var got := String(translation.get_plural_message("{count} ONE", "{count} MANY", n, "t")) if translation else ""
			if got != "F%d" % _plural_index(code, n):
				wrong.append("%d -> %s" % [n, got])
		_check(wrong.is_empty(), "%s: Godot picks the expected plural form for every n%s" % [code, _list(wrong)])


## Gate on, the real Language autoload loads the real catalogs: each entry translates to its msgstr,
## or to the English when it is untranslated or fuzzy.
func _fallback_to_english(template: Dictionary, catalogs: Dictionary) -> void:
	Economy.languages_force = 1
	progress.language = ""
	language.enable()
	_check(language.active and language.loaded_catalogs().size() == PLURAL_FORMS.size(),
		"gate on: Language loads the %d catalogs" % PLURAL_FORMS.size())
	for code: String in PLURAL_FORMS:
		var po: Dictionary = catalogs[code]
		if not po.ok:
			continue
		language.set_locale(code)
		var wrong: Array[String] = []
		for ctx: String in template.entries:
			var want: Dictionary = template.entries[ctx]
			var entry: Dictionary = po.entries.get(ctx, {})
			var usable: bool = not entry.is_empty() and not entry.fuzzy and entry.msgid == want.msgid
			for n: int in ([1, 2, 5, 21] if want.plural != null else [-1]):
				var english: String = want.msgid if n == 1 or want.plural == null else want.plural
				var expect := english
				var got := ""
				if want.plural == null:
					got = String(TranslationServer.translate(want.msgid, ctx))
					if usable and entry.msgstr[0] != "":
						expect = entry.msgstr[0]
				else:
					got = String(TranslationServer.translate_plural(want.msgid, want.plural, n, ctx))
					var forms: Array = entry.get("msgstr", [])
					var k := _plural_index(code, n)
					if usable and not forms.has("") and k < forms.size():
						expect = forms[k]
				if got != expect:
					wrong.append("%s: %s" % [ctx, got])
		_check(wrong.is_empty(), "%s: Godot returns each translation, English where untranslated%s" % [code, _list(wrong)])
	language.disable()
	Economy.languages_force = -1
	Economy.forced_locale = ""
	progress.language = ""
	_check(not Economy.languages_on() and TranslationServer.get_loaded_locales().is_empty(), "gate back off, nothing loaded")


# --- PO parsing -------------------------------------------------------------------------------------------

## {ok, header: {field: value}, entries: {ctx: {msgid, plural (null if none), msgstr: Array, fuzzy, lines}}}.
## Obsolete (#~) entries are skipped, as Godot does.
func _parse(path: String) -> Dictionary:
	var out := {ok = false, header = {}, entries = {}}
	if not FileAccess.file_exists(path):
		return out
	var blocks: Array = [[]]
	for line in FileAccess.get_file_as_string(path).split("\n"):
		if line.strip_edges() == "":
			if not (blocks[-1] as Array).is_empty():
				blocks.append([])
		else:
			(blocks[-1] as Array).append(line)
	var ok := true
	for block: Array in blocks:
		if block.is_empty() or block.any(func(l: String) -> bool: return l.begins_with("#~")) \
				or block.all(func(l: String) -> bool: return l.begins_with("#")):
			continue
		var entry := {ctx = "", msgid = "", plural = null, msgstr = [], fuzzy = false, lines = 0}
		var field := ""
		for line: String in block:
			if line.begins_with("#,"):
				entry.fuzzy = entry.fuzzy or line.contains("fuzzy")
				continue
			if line.begins_with("#."):
				var m := _budget_lines.search(line.substr(2).strip_edges())
				if m:
					entry.lines = int(m.get_string(1))
				continue
			if line.begins_with("#"):
				continue
			var value := ""
			if line.begins_with('"'):
				value = _unquote(line)
				match field:
					"msgctxt": entry.ctx += value
					"msgid": entry.msgid += value
					"msgid_plural": entry.plural += value
					_:
						if field.begins_with("msgstr"):
							entry.msgstr[-1] += value
						else:
							ok = false
				continue
			var space := line.find(" ")
			field = line.substr(0, space)
			value = _unquote(line.substr(space + 1))
			match field:
				"msgctxt": entry.ctx = value
				"msgid": entry.msgid = value
				"msgid_plural": entry.plural = value
				_:
					if field == "msgstr" or field.begins_with("msgstr["):
						entry.msgstr.append(value)
					else:
						ok = false
		if entry.msgid == "" and entry.ctx == "":
			for header_line in (entry.msgstr[0] as String).split("\n", false):
				var colon := header_line.find(":")
				if colon > 0:
					out.header[header_line.substr(0, colon).strip_edges()] = header_line.substr(colon + 1).strip_edges()
			continue
		if out.entries.has(entry.ctx):
			ok = false
		out.entries[entry.ctx] = entry
	out.ok = ok
	return out


func _unquote(text: String) -> String:
	var s := text.strip_edges()
	return s.substr(1, s.length() - 2).c_unescape() if s.length() >= 2 else ""


# --- helpers -------------------------------------------------------------------------------------------

func _names(text: String) -> Dictionary:
	var out := {}
	for m in _placeholder.search_all(text):
		out[m.get_string(1)] = true
	return out


func _nplurals(code: String) -> int:
	return int((PLURAL_FORMS[code] as String).get_slice(";", 0).get_slice("=", 1))


## The plural form for n, written out per rule (independent of Godot's own evaluation).
func _plural_index(code: String, n: int) -> int:
	match code:
		"es", "de", "it", "tr":
			return 0 if n == 1 else 1
		"pt_BR", "fr", "hi":
			return 1 if n > 1 else 0
		"ru":
			if n % 10 == 1 and n % 100 != 11:
				return 0
			return 1 if n % 10 >= 2 and n % 10 <= 4 and (n % 100 < 10 or n % 100 >= 20) else 2
		"pl":
			if n == 1:
				return 0
			return 1 if n % 10 >= 2 and n % 10 <= 4 and (n % 100 < 10 or n % 100 >= 20) else 2
		"ar":
			if n <= 2:
				return n
			if n % 100 >= 3 and n % 100 <= 10:
				return 3
			return 4 if n % 100 >= 11 else 5
	return 0


## True when plural form `form` of `code` is used for exactly one n (it may say "one" instead of {count}).
func _single_n_form(code: String, form: int) -> bool:
	var hits := 0
	for n in 2000:
		if _plural_index(code, n) == form:
			hits += 1
			if hits > 1:
				return false
	return hits == 1


func _list(items: Array) -> String:
	if items.is_empty():
		return ""
	var shown := items.slice(0, 8)
	return " (%d: %s%s)" % [items.size(), ", ".join(shown), ", ..." if items.size() > 8 else ""]
