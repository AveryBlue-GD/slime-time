{
  "permissions": {
    "allow": [
      "PowerShell(.\\tools\\godot.ps1 *)",
      "PowerShell(.\\tools\\screenshot.ps1 *)",
      "PowerShell(.\\tools\\screenshot.ps1)",
      "PowerShell(python tools/*)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "Bash(powershell -File tools/godot.ps1 *)",
      "Bash(powershell -File tools/screenshot.ps1 *)",
      "Bash(python tools/*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(./tools/godot.sh *)",
      "Bash(./tools/screenshot.sh *)",
      "Bash(./tools/test_all.sh)",
      "Bash(./tools/test_all.sh *)",
      "Bash(./tools/play.sh *)",
      "Bash(./tools/play.sh)",
      "Bash(python3 tools/*)",
      "Bash(python3 -I tools/*)",
      "Bash(git branch *)",
      "Bash(git show *)",
      "Bash(git stash *)"
    ],
    "deny": [
      "Read(./.godot/**)",
      "Read(./.screens/*.wav)",
      "Read(./build/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
